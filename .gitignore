# Exclude executable shortcuts for retired hardware experiments: some of
# those USB/driver lab scripts previously caused PSP black-screen failures.
# Keep only end-user product startup/backup shortcuts.
/*.cmd
!/Iniciar-PSP-Dock.cmd
!/Ver-demostracion.cmd
!/Activar-inicio-automatico-Windows.cmd
!/Desactivar-inicio-automatico-Windows.cmd
!/Respaldar-PSP.cmd

# Include the actual copyleft license attribution (plain text, not binaries)
!homebrew/psp-dock-app/LICENSE-FuSa-GPL-3.0.txt
!homebrew/bridge-hid/LICENSE

