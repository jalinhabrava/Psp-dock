# Keep only product startup, demo and safe-backup shortcuts.
/*.cmd
!/Iniciar-PSP-Dock.cmd
!/Ver-demostracion.cmd
!/Respaldar-PSP.cmd

# The native PSP 0308 firmware and licensed artwork are intentionally shipped.
!homebrew/native-dock/assets/*.PNG
!homebrew/native-dock/assets/sources/*.png

# Local chronological handoff and machine-specific evidence
