<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- One APK and task: process isolation permits a fresh native VM per game. -->
        <activity
            android:name="org.ppsspp.ppsspp.PpssppActivity"
            android:configChanges="locale|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:launchMode="standard"
            android:process=":emulation"
            android:screenOrientation="landscape"
            android:theme="@style/ppsspp_style" />
        <activity
            android:name="org.ppsspp.ppsspp.ImageResultProxyActivity"
            android:exported="false"
            android:process=":emulation"
            android:theme="@style/Theme.ProxyTransparent" />
        <activity
            android:name="org.ppsspp.ppsspp.DocumentResultProxyActivity"
            android:exported="false"
            android:process=":emulation"
            android:theme="@style/Theme.ProxyTransparent" />
    </application>
</manifest>
